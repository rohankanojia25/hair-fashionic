    {
      "parameters": {
        "jsCode": "// Filter clients for rebooking cadences based on Asia/Kolkata timezone\nconst today = new Date();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  \n  // Check consent and existing nudge\n  const isOptedIn = String(row.opted_in || '').toLowerCase() === 'true';\n  if (!isOptedIn || row.rebook_nudge_sent_at) {\n    continue;\n  }\n  \n  if (!row.visit_date) continue;\n  \n  const visitDate = new Date(row.visit_date);\n  const diffDays = Math.floor((today - visitDate) / (1000 * 60 * 60 * 24));\n  \n  const service = String(row.service || '').toLowerCase();\n  let shouldNudge = false;\n  let cadenceLabel = '';\n  \n  // 28 days for haircut\n  if (service.includes('haircut') || service.includes('grooming') || service.includes('beard')) {\n    if (diffDays === 28) {\n      shouldNudge = true;\n      cadenceLabel = '4 weeks';\n    }\n  }\n  \n  // 21 days for colour touch-up or hair spa\n  if (service.includes('colour') || service.includes('color') || service.includes('spa') || service.includes('keratin')) {\n    if (diffDays === 21) {\n      shouldNudge = true;\n      cadenceLabel = '3 weeks';\n    }\n  }\n  \n  if (shouldNudge) {\n    let cleanPhone = String(row.phone || '').replace(/\\D/g, '');\n    if (cleanPhone.length === 10) cleanPhone = '91' + cleanPhone;\n    \n    results.push({\n      json: {\n        name: row.name || 'Valued Client',\n        phone: cleanPhone,\n        service: row.service || 'hair service',\n        stylist: row.stylist || 'Rahees',\n        visit_date: row.visit_date,\n        cadence_label: cadenceLabel,\n        days_ago: diffDays\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "node-wf2-filter-nudge",
      "name": "Filter 28-day & 21-day Cadences",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        530
      ]
    },
