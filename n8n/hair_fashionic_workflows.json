    {
      "parameters": {
        "jsCode": "const broadcastOffer = $('Webhook - Trigger Festival Broadcast').first().json.body?.offer_text || 'Exclusive Festival Glow Package';\nconst festivalName = $('Webhook - Trigger Festival Broadcast').first().json.body?.festival_name || 'Festive Season';\nconst validity = $('Webhook - Trigger Festival Broadcast').first().json.body?.validity || 'this Sunday';\n\nconst optedInClients = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const isOptedIn = String(row.opted_in || '').toLowerCase() === 'true';\n  if (isOptedIn && row.phone) {\n    let cleanPhone = String(row.phone).replace(/\\D/g, '');\n    if (cleanPhone.length === 10) cleanPhone = '91' + cleanPhone;\n    \n    optedInClients.push({\n      json: {\n        name: row.name || 'Valued Guest',\n        phone: cleanPhone,\n        festival_name: festivalName,\n        offer_text: broadcastOffer,\n        validity: validity\n      }\n    });\n  }\n}\n\nreturn optedInClients;"
      },
