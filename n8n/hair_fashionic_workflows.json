      "parameters": {
        "jsCode": "// Sanitize and clean Indian phone number format for WhatsApp Cloud API\nlet rawPhone = String($json.phone || '').replace(/\\D/g, '');\nif (rawPhone.length === 10) {\n  rawPhone = '91' + rawPhone;\n} else if (rawPhone.startsWith('0') && rawPhone.length === 11) {\n  rawPhone = '91' + rawPhone.substring(1);\n}\n\nconst clientName = ($json.name || 'Valued Client').trim();\nconst stylist = ($json.stylist || 'Rahees').trim();\nconst service = ($json.service || 'haircut & styling').trim();\nconst rowNumber = $json.row_number || $json.__rowNumber || 2;\n\nreturn {\n  json: {\n    client_name: clientName,\n    phone_e164: rawPhone,\n    stylist: stylist,\n    service: service,\n    row_number: rowNumber,\n    google_review_link: 'https://search.google.com/local/writereview?placeid=YOUR_GOOGLE_PLACE_ID'\n  }\n};"
      },
