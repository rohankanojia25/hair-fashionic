    {
      "parameters": {
        "jsCode": "// Compute Yesterday in Asia/Kolkata\nconst now = new Date();\nconst yesterday = new Date(now);\nyesterday.setDate(now.getDate() - 1);\nconst yyyy = yesterday.getFullYear();\nconst mm = String(yesterday.getMonth() + 1).padStart(2, '0');\nconst dd = String(yesterday.getDate()).padStart(2, '0');\nconst yesterdayStr = `${yyyy}-${mm}-${dd}`;\n\nlet yesterdayVisits = 0;\nlet reviewRequestsSent = 0;\nconst stylistCounts = {};\nconst serviceCounts = {};\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const visitDate = String(row.visit_date || '').trim();\n  \n  if (visitDate === yesterdayStr || visitDate.startsWith(yesterdayStr)) {\n    yesterdayVisits++;\n    if (row.review_sent_at) {\n      reviewRequestsSent++;\n    }\n    \n    const st = row.stylist || 'Unassigned';\n    stylistCounts[st] = (stylistCounts[st] || 0) + 1;\n    \n    const srv = row.service || 'Other';\n    serviceCounts[srv] = (serviceCounts[srv] || 0) + 1;\n  }\n}\n\nlet stylistBreakdown = Object.entries(stylistCounts)\n  .map(([k, v]) => `• ${k}: ${v} visit(s)`)\n  .join('\\n') || '• No visits logged';\n\nlet serviceBreakdown = Object.entries(serviceCounts)\n  .map(([k, v]) => `• ${k}: ${v}`)\n  .join('\\n') || '• No services logged';\n\nreturn {\n  json: {\n    report_date: yesterdayStr,\n    total_visits: yesterdayVisits,\n    reviews_sent: reviewRequestsSent,\n    stylist_breakdown: stylistBreakdown,\n    service_breakdown: serviceBreakdown,\n    owner_phone: '918587041387'\n  }\n};"
      },
